{
    "pythonVersion": "3.11",
    "include": ["packages/**/*.py"],
    "ignore": [
        "**/__init__.py",
        "packages/llm_inference/src/llm_inference/openai_api.py",
        "packages/llm_inference/src/llm_inference/openai_api_compatible.py",
        "packages/llm_inference/src/llm_inference/vllm_offline_inference.py",
        "packages/llm_inference/src/llm_inference/sglang_offline_inference.py",
        "tests/**/*.py",
        "smoke_tests/**/*.py",
        "scripts/**/*.py"
    ],
    "reportMissingTypeStubs": false,
    "reportUnnecessaryComparison": false,
    "reportUnnecessaryIsInstance": false,
    "typeCheckingMode": "strict"
}
